# 301-Weiterleitungen der alten WordPress-URLs auf den Onepager.
# Erhält SEO-Wert und vermeidet 404s nach dem Umzug.
# Reihenfolge: spezifische Regeln zuerst, Admin-Unterpfade zuletzt.

# Inhaltsseiten -> passende Abschnitte
/ueber-uns                          /#uber-uns      301
/kontakt                            /#kontakt       301
/elementor-81/immobilie-bewerten    /#wertrechner   301
/elementor-81/verkauf-2             /#leistungen    301
/elementor-81/vermieten             /#leistungen    301
/elementor-81/immobilie-aufwerten   /#leistungen    301

# Rechtsseiten -> echte Routen (/impressum & /datenschutz werden vom SPA bedient)
/datenschutzerklaerung              /datenschutz    301
/cookie-richtlinie-eu               /datenschutz    301

# Autoren-Archive -> Team / Ueber uns
/author/jana-meier                  /#uber-uns      301
/author/timo-konrad                 /#uber-uns      301

# WordPress-/Plugin-Reste -> Startseite
/elementor-81                       /               301
/yith-compare                       /               301
/hello-world                        /               301
/category/uncategorized             /               301

# ÜBERGABE SEO: Pages liefert impressum.html/datenschutz.html/admin.html automatisch
# unter den gleichnamigen Pfaden ohne .html aus. Keine globale Proxy-Regel verwenden,
# die diese Dateien oder JS-/Bilddateien durch die Startseite ersetzen würde.
/impressum/                         /impressum       301
/datenschutz/                       /datenschutz     301
/admin/                             /admin           301

# Admin-Unterpfade erhalten dieselbe Anwendung, bereits mit noindex im HTML.
/admin/*                            /admin           200

# Für übrige React-Routen greift Pages' eingebauter SPA-Fallback ohne 404.html.
# API-Anfragen bleiben bei den eigenen Pages Functions unter functions/api/.
